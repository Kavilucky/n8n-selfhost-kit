{
  "name": "4. Вебхук формы с сайта",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-form",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a4000000-0000-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [260, 300],
      "webhookId": "lead-form"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "1", "name": "name", "type": "string", "value": "={{$json.body.name}}" },
            { "id": "2", "name": "contact", "type": "string", "value": "={{$json.body.phone || $json.body.email}}" },
            { "id": "3", "name": "text", "type": "string", "value": "={{$json.body.message}}" },
            { "id": "4", "name": "source", "type": "string", "value": "сайт (webhook)" }
          ]
        }
      },
      "id": "a4000000-0000-4000-8000-000000000002",
      "name": "Нормализовать поля формы",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": true } }}"
      },
      "id": "a4000000-0000-4000-8000-000000000003",
      "name": "Ответ форме (200 OK)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.2,
      "position": [700, 300]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Нормализовать поля формы", "type": "main", "index": 0 }]] },
    "Нормализовать поля формы": { "main": [[{ "node": "Ответ форме (200 OK)", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": {
    "description": "Принимает POST-запрос от HTML-формы (поля name/phone или email/message), приводит их к общему виду name/contact/text/source и сразу отвечает формe 200 OK. URL вебхука после активации: https://ТВОЙ_ДОМЕН/webhook/lead-form. Между 'Нормализовать поля формы' и ответом вставь Execute Workflow на шаблоны 2 и 3, чтобы лид улетал в таблицу и менеджеру."
  }
}
