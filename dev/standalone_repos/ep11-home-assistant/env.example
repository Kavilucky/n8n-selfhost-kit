# Скопируйте этот файл в .env (имя начинается с точки) рядом с docker-compose.yml и впишите свои значения.
# Файл .env никому не отправляйте и не выкладывайте: в нём пароль.
# Часовой пояс (например Europe/Moscow, Asia/Yekaterinburg).
TZ=Europe/Moscow
# Путь к вашему USB-координатору Zigbee: выполните ls -l /dev/serial/by-id/ и впишите строку вида /dev/serial/by-id/usb-...
ZIGBEE_DEVICE=/dev/serial/by-id/ЗАМЕНИТЕ_НА_ВАШ_КООРДИНАТОР
# Пользователь и пароль, под которыми Zigbee2MQTT заходит в Mosquitto (те же значения вы зададите командой из раздела 3 инструкции).
MQTT_ZIGBEE_USER=zigbee2mqtt
MQTT_ZIGBEE_PASSWORD=ЗАМЕНИТЕ_НА_СВОЙ_ПАРОЛЬ
