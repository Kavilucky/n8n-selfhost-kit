    {
      "parameters": {
        "jsCode": "const tasks = $('Разобрать задачи').all().map(i => i.json);\nconst chatId = tasks[0].chat_id;\nconst names = { meeting: 'Встреча', reminder: 'Напоминание', note: 'Заметка' };\nlet text;\nif (tasks[0].type === 'empty') {\n  text = 'Не получилось разобрать задачи. Повторите, пожалуйста.';\n} else {\n  const parts = tasks.map(t => names[t.type] + ': ' + t.title);\n  text = 'Принято, задач: ' + tasks.length + '. ' + parts.join('. ') + '.';\n}\nreturn [{ json: { text, chat_id: chatId } }];"
      },
