    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:11434/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'qwen2.5:3b', stream: false, format: 'json', prompt: 'Ты извлекаешь задачи из надиктованной речи водителя. Речь живая, с паузами, поправками и повторами. Сейчас: ' + $now.toISO() + '. Верни только JSON вида {\"tasks\":[{\"type\":\"meeting|reminder|note\",\"title\":\"кратко\",\"datetime\":\"ISO 8601 или пустая строка\",\"details\":\"уточнения\"}]}. meeting: встреча или звонок с временем. reminder: напоминание на дату. note: заметка без времени. Относительные даты (четверг, завтра, в пятницу) переведи в дату от текущего момента. Ничего не выдумывай: нет времени, значит datetime пустой. Речь: ' + $json.text + '' }) }}",
        "options": {}
      },
      "id": "a86f5437-dce1-5e48-9261-acef6f8b9612",
      "name": "Извлечь задачи",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.response || '';\nconst chatId = $('Telegram Trigger').first().json.message.chat.id;\nlet tasks = [];\ntry {\n  const p = JSON.parse(raw);\n  tasks = Array.isArray(p.tasks) ? p.tasks : [];\n} catch (e) {\n  tasks = [];\n}\nconst out = [];\nfor (const t of tasks) {\n  const title = String(t.title || '').trim();\n  if (!title) continue;\n  const details = String(t.details || '').trim();\n  let type = ['meeting', 'reminder', 'note'].includes(t.type) ? t.type : 'note';\n  const d = t.datetime ? new Date(t.datetime) : null;\n  const okDate = d && !isNaN(d.getTime());\n  if (type !== 'note' && !okDate) type = 'note';\n  const minutes = type === 'meeting' ? 60 : 15;\n  out.push({ json: {\n    type,\n    route: type === 'note' ? 'notion' : 'calendar',\n    title,\n    details,\n    start: okDate ? d.toISOString() : '',\n    end: okDate ? new Date(d.getTime() + minutes * 60000).toISOString() : '',\n    chat_id: chatId,\n  } });\n}\nif (!out.length) {\n  out.push({ json: { type: 'empty', route: 'none', title: '', details: '', start: '', end: '', chat_id: chatId } });\n}\nreturn out;"
      },
