{
  "name": "Новости: рерайтинг и фактчекинг (n8n + Ollama)",
  "nodes": [
    {
      "parameters": {
        "content": "## Новости: рерайтинг и фактчекинг (n8n + Ollama)\n\n**Перед запуском:**\n1. Установите Ollama и модель: `ollama pull qwen2.5:3b` (ответы идут на ваш компьютер, в облако не уходят).\n2. Узел «RSS»: подставьте адреса своих лент (или добавьте узлы чтения по аналогии).\n3. Telegram: создайте бота у @BotFather, добавьте credentials, впишите ID чата модерации и ID канала.\n4. Кнопки работают через Telegram Trigger: ему нужен публичный HTTPS-адрес вебхука (WEBHOOK_URL или туннель). Это единственная часть, которой нужен внешний адрес.\n\nФактчекинг здесь простой: числа из поста сверяются с исходным текстом. Это подсказка, а не гарантия правды.",
        "height": 360,
        "width": 520,
        "color": 4
      },
      "id": "0db73812-2c5d-525b-99fa-88684cdc046d",
      "name": "Инструкция",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        -120
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "e294928f-1224-5ae1-be5c-9bd65dcf4719",
      "name": "Каждые 30 минут",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        400,
        100
      ]
    },
    {
      "parameters": {
        "url": "https://example.com/feed.xml"
      },
      "id": "1df855a2-7a9f-53e3-89ab-dd07cda49899",
      "name": "RSS",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [
        640,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:11434/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'qwen2.5:3b', stream: false, prompt: 'Перепиши новость для Telegram-канала: заголовок одной строкой, затем суть в двух предложениях. Ничего не выдумывай, используй только факты из текста. Если в тексте есть числа, оставь их без изменений. Текст новости: ' + ($json.contentSnippet || $json.content || $json.title || '') }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "fa6f90d3-056e-5f2c-b140-62e47f1ccf2c",
      "name": "Ollama Qwen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        100
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const src = $('RSS').item.json;\nconst source = [src.title, src.contentSnippet, src.content].filter(Boolean).join(' ');\nconst post = ($json.response || '').trim();\nconst norm = (s) => s.replace(/[\\s\\u00a0]/g, '').replace(',', '.');\nconst tokens = (s) => (s.match(/\\d[\\d\\s\\u00a0]*\\d|\\d/g) || []).map(norm);\nconst srcNums = new Set(tokens(source));\nconst missing = [...new Set(tokens(post).filter((n) => !srcNums.has(n)))];\nconst mark = missing.length\n  ? 'ПРОВЕРЬТЕ: этих чисел нет в источнике: ' + missing.join(', ')\n  : 'Числа из поста найдены в источнике (это не гарантия правды).';\nreturn { json: { text: post + '\\n\\n' + mark + '\\n\\nИсточник: ' + (src.link || ''), missing } };"
      },
      "id": "747763c7-9f1d-5bce-947c-60f04747012a",
      "name": "Фактчекинг",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        100
      ]
    },
    {
      "parameters": {
        "chatId": "REPLACE_WITH_MODERATION_CHAT_ID",
        "text": "={{ $json.text }}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "Опубликовать",
                    "additionalFields": {
                      "callback_data": "publish"
                    }
                  },
                  {
                    "text": "Отклонить",
                    "additionalFields": {
                      "callback_data": "reject"
                    }
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "b24dcda6-7330-525e-87fe-749e2819c063",
      "name": "Telegram модерация",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1360,
        100
      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "updates": [
          "callback_query"
        ],
        "additionalFields": {}
      },
      "id": "8398083c-61c2-57e7-9ccc-967d8b72d20e",
      "name": "Нажатие кнопки",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        400,
        520
      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.callback_query.data }}",
              "value2": "publish"
            }
          ]
        }
      },
      "id": "2d12bf23-670e-5ecb-8a39-cc8d0e914952",
      "name": "Опубликовать?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        640,
        520
      ]
    },
    {
      "parameters": {
        "chatId": "REPLACE_WITH_CHANNEL_ID",
        "text": "={{ $json.callback_query.message.text }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "10fd0dac-cdb3-550d-a798-591871741735",
      "name": "В канал",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        900,
        440
      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "resource": "callback",
        "operation": "answerQuery",
        "queryId": "={{ $('Нажатие кнопки').item.json.callback_query.id }}",
        "additionalFields": {
          "text": "Опубликовано"
        }
      },
      "id": "df4b4bda-c686-5426-9b7e-f8330a86576e",
      "name": "Ответ: опубликовано",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1140,
        440
      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "resource": "callback",
        "operation": "answerQuery",
        "queryId": "={{ $json.callback_query.id }}",
        "additionalFields": {
          "text": "Отклонено"
        }
      },
      "id": "88abbb4e-bd93-5880-a530-0a815c0c39a8",
      "name": "Ответ: отклонено",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        900,
        620
      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram account"
        }
      }
    }
  ],
